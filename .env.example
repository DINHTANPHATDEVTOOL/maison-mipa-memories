# ==============================================================================
# Maison MIPA Memories - Environment Variables Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Vite Client Bundle)
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER expose server-side secrets or service-role keys here!
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Demo Mode Flag (Default: false in production)
# When false, demo auth bypasses are disabled and real Supabase Auth is enforced.
VITE_ENABLE_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (Supabase Edge Functions / Backend Only)
# Configure via Supabase CLI: supabase secrets set KEY=VALUE
# DO NOT PREFIX WITH VITE_! NEVER EXPOSE TO FRONTEND!
# ------------------------------------------------------------------------------
# SMS Provider Configuration (eSMS or SpeedSMS)
SMS_PROVIDER=esms
SMS_API_KEY=your_esms_api_key
SMS_SECRET=your_esms_secret_key
SMS_BRANDNAME=MIPA

# Server Pepper for OTP Hashing (HMAC / SHA-256)
OTP_PEPPER=your_secure_server_pepper_min_32_characters

# Payment Gateway / Webhook Verification Secrets
PAYMENT_WEBHOOK_SECRET=your_hmac_sha256_webhook_secret
PAYMENT_PROVIDER_SECRET=your_payment_provider_secret_key
