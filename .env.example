# ==============================================================================
# Maison MIPA Memories - Environment Variables Configuration (.env.example)
# Production Project Reference: dkvkhysnabhtbbuvommu
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Vite Client Bundle)
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER expose server-side secrets or service-role keys here!
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://dkvkhysnabhtbbuvommu.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-project-anon-key

# Demo Mode Flag (Default: false in production)
# When false, demo auth bypasses are disabled and real Supabase Auth is enforced.
VITE_ENABLE_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (Supabase Edge Functions / Backend Only)
# Configure via Supabase CLI: supabase secrets set KEY=VALUE
# or via Supabase Dashboard -> Project Settings -> Edge Functions Secrets
# DO NOT PREFIX WITH VITE_! NEVER EXPOSE TO FRONTEND BUNDLE!
# ------------------------------------------------------------------------------
# Supabase Server Key
SUPABASE_URL=https://dkvkhysnabhtbbuvommu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend Email Configuration (Primary Transactional Email Provider)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Maison MIPA Memories <contact@maisonmipa.io.vn>
EMAIL_REPLY_TO=contact@maisonmipa.io.vn

# payOS Gateway & ACB Banking Integration
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYMENT_WEBHOOK_SECRET=your_legacy_hmac_sha256_secret

# SMS Provider Configuration (eSMS or SpeedSMS)
SMS_PROVIDER=esms
SMS_API_KEY=your_esms_api_key
SMS_SECRET=your_esms_secret_key
SMS_BRANDNAME=MIPA

# Server Pepper for OTP Hashing (HMAC / SHA-256)
OTP_PEPPER=your_secure_server_pepper_min_32_characters
