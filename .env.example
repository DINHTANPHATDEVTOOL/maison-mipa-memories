# ==============================================================================
# Maison MIPA Memories - Frontend Environment Variables (.env.example)
# Note: ONLY public anon variables are exposed to the frontend bundle.
# NEVER put service_role keys, SMS secrets, or database passwords in this file!
# ==============================================================================

# Supabase Public Configuration (Required for Production Auth & Backend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Demo Mode Flag (Default: false in production)
# When set to false, all mock auth bypasses and quick role switchers are disabled.
VITE_ENABLE_DEMO_MODE=false
